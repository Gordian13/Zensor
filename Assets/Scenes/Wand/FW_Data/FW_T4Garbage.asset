  m_Script: {fileID: 11500000, guid: fbf53cf59c492414ba5ce3b9941f083c, type: 3}
  m_Name: FW_T4Garbage
  m_EditorClassIdentifier: Assembly-CSharp::FotowandData
  photo: {fileID: 21300000, guid: 642251a6991ec764982cf1cd7e21166f, type: 3}
  title: "Garbage & Din A Testbild \u2013 Live at Zensor"
  description: "Dieses fr\xFChe Zensor-Plakat zeigt den Laden im Blue-Moon Hinterraum
    als B\xFChne, B\xFCro und Sender zugleich: Din A Testbild und Frieder Butzmann
    spielten am 2.6. um 16 Uhr im Keller von Zensor, Belziger Stra\xDFe 23."
  hasExtraInfo: 1
  extraInfoTitle: In-Store Concerts at Zensor
  extraInfoContent: "Das handgemachte Konzertplakat k\xFCndigt \u201EGarbage\u201C,
    \u201Efrdaha p\xF8tzm*n\u201C / Frieder Butzmann mit Tapes und Saxofon sowie
    Din A Testbild f\xFCr den 2. Juni, 16 Uhr, beim Zensor, Belzigerstra\xDFe 23,
    im Blue Moon an. Es geh\xF6rt zur ganz fr\xFChen Zensor-Zeit, als Burkhardt Seilers
    Plattenladen nicht nur Verkaufsraum war, sondern auch Kellerb\xFChne, Treffpunkt,
    Mailorder-Zentrale und\nProduktionsidee. Frieder Butzmann war dabei nicht nur
    K\xFCnstler, sondern arbeitete auch im Zensor-Umfeld, besonders beim Versand
    / Mailorder-Service, der die West-Berliner Musik weit \xFCber die Inselstadt
    hinaustrug. Din A Testbild geh\xF6rten zu den wichtigen fr\xFChen Gruppen zwischen
    Punk, Elektronik, Dada, Krach und Neuer Deutscher Welle. Die Ver\xF6ffentlichung
    \u201EAbfall / Garbage / Glas-Konkav\u201C steht genau f\xFCr diesen Moment:
    Musik als Abfallprodukt, St\xF6rung, Fundst\xFCck und Signal. Nicht sauber, nicht
    brav, nicht f\xFCr den Markt gegl\xE4ttet \u2014 sondern roh genug, um wahr zu
    sein. Zensor machte aus solchen Momenten keine Legende im Nachhinein, sondern
    sofort ein Medium: Konzert, Platte, Kassette, Bestellung, Gespr\xE4ch."
  extraInfoImage: {fileID: 0}
